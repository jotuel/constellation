<component type="desktop-application">
  <id>fi.joonastuomi.Constellation</id>

  <name>Constellation</name>
  <summary>Matrix client for the COSMIC desktop</summary>
  <developer id="fi.joonastuomi">
    <name>Joonas Tuomi</name>
  </developer>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <description>
    <p>
      Constellation is a Matrix client built with libcosmic for the COSMIC
      desktop and powered by matrix-rust-sdk.
    </p>
    <p>
      This is alpha-quality software. It is usable, but you should expect bugs,
      missing features, and potential breaking changes between releases.
    </p>
  </description>

  <launchable type="desktop-id">fi.joonastuomi.Constellation.desktop</launchable>

  <provides>
    <url_scheme>matrix</url_scheme>
  </provides>

  <screenshots>
    <screenshot type="default">
      <caption>Constellation main chat view</caption>
      <image type="source">https://raw.githubusercontent.com/jotuel/constellation/main/res/screenshots/main.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/jotuel/constellation</url>
  <url type="bugtracker">https://github.com/jotuel/constellation/issues</url>
  <url type="vcs-browser">https://github.com/jotuel/constellation</url>
  <url type="donation">https://github.com/sponsors/jotuel</url>

  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
    <category>Chat</category>
  </categories>

  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>

  <recommends>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>

  <releases>
    <release version="0.2.0" date="2026-09-08" type="development">
      <url type="details">https://github.com/jotuel/constellation/releases/tag/v0.2.0</url>
      <description>
        <p>Second alpha release of Constellation.</p>
        <p>Highlights:</p>
        <ul>
          <li>Tabbed chat interface with keyboard shortcuts and secondary action menus</li>
          <li>Spaces in the COSMIC navigation bar and resizable sidebar divider</li>
          <li>Global and in-room full-text message search with server-side queries and local fallback</li>
          <li>In-app video playback with autoplay support</li>
          <li>Open Graph rich link previews and native selectable text</li>
          <li>Real MSC4108 QR code login flow</li>
          <li>Customizable keyboard shortcuts settings</li>
          <li>Unread-room cards on empty chat state</li>
          <li>COSMIC Config integration</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-07-09" type="development">
      <url type="details">https://github.com/jotuel/cosmic-ext-constellation/releases/tag/v0.1.0-alpha</url>
      <description>
        <p>First alpha release of Constellation.</p>
        <p>Highlights:</p>
        <ul>
          <li>UnifiedPush background notifications</li>
          <li>QR code login</li>
          <li>End-to-end encryption with session verification</li>
          <li>Location sharing</li>
          <li>Room members &amp; pinned messages panels</li>
          <li>Stable timeline scrolling, start from oldest unread</li>
          <li>MatrixRTC group calls (experimental, powered by LiveKit)</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
